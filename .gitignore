# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Lock files are committed for root modules (envs/), not reusable modules
terraform/modules/**/.terraform.lock.hcl

# Editor / OS
.DS_Store
.idea/
.vscode/

# Deployment-specific variable files (may contain account IDs / config)
*.tfvars

# Local partial-backend config (contains account-specific bucket names)
backend.hcl

# Local Terraform overrides (e.g. a backend for bootstrap/github-oidc state)
*_override.tf
